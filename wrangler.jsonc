{
  "name": "pinnedkorea",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "pinnedkorea.com", "custom_domain": true },
    { "pattern": "www.pinnedkorea.com", "custom_domain": true }
  ],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["0 14 * * *"] },
  "vars": { "NOTIFY_EMAIL": "autoboxtv@gmail.com" },
  "durable_objects": { "bindings": [{ "name": "BOARD", "class_name": "Board" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Board"] }]
}
